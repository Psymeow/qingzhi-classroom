[project]
sub_id = "a88a1834"
name = "qingzhi-classroom"
requires = [ "nodejs-24" ]
project_type = "web"
version = "0.1.9"
project_id = "7699073508965515298"
app_id = "7703914468035788810"

[preview]
preview_enable = "enabled"

[dev]
build = [ "bash", "./scripts/prepare.sh" ]
build_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/prepare.ps1"
]
run = [ "bash", "./scripts/dev.sh" ]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/dev.ps1"
]
validate = [ "bash", "./scripts/validate.sh" ]
validate_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/validate.ps1"
]

[deploy]
build = [ "bash", "./scripts/build.sh" ]
build_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/build.ps1"
]
run = [ "bash", "./scripts/start.sh" ]
run_win = [
  "powershell.exe",
  "-NoProfile",
  "-ExecutionPolicy",
  "Bypass",
  "-File",
  "./scripts/start.ps1"
]
deps = [ "git" ]

[deploy.profile]
kind = "service"
flavor = "web"

[subprojects]
path = [ "." ]